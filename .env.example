# ==========================================
# foto — Private Photo & Video Gallery Configuration
# ==========================================

# Supabase Credentials (from your Supabase Project Settings > API)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Gallery Customization
VITE_GALLERY_NAME="Bipin's Personal Gallery"
VITE_OWNER_NAME="Bipin Yadav"
VITE_PROFILE_PHOTO_URL=""

# Authentication & Passwords
# (These will match the accounts registered in Supabase Auth via the Setup Wizard)
# Default Viewer Email: viewer@foto.gallery (or custom)
# Default Admin Email: admin@foto.gallery (or custom)
VITE_VIEWER_PASSWORD="viewer123"
VITE_ADMIN_PASSWORD="admin123"

# GEMINI_API_KEY: Optional for server-side capabilities
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

